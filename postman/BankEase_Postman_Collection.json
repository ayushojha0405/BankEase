  "item": [
    {
      "name": "Account Service (:8081)",
      "item": [
        {
          "name": "1. Create Account (Rahul Sharma - Savings)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountHolderName\": \"Rahul Sharma\",\n  \"accountType\": \"SAVINGS\",\n  \"initialDeposit\": 10000.00\n}"
            },
            "url": {
              "raw": "{{account_service_url}}/api/v1/accounts",
              "host": [
                "{{account_service_url}}"
              ],
              "path": [
                "api",
                "v1",
                "accounts"
              ]
            }
          }
        },
        {
          "name": "2. Create Account (Priya Patel - Current)",
          "request": {
