    {
      "name": "Transaction Service (:8082)",
      "item": [
        {
          "name": "1. Deposit Funds",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": 1,\n  \"amount\": 2500.00,\n  \"description\": \"Salary bonus deposit\"\n}"
            },
            "url": {
              "raw": "{{transaction_service_url}}/api/v1/transactions/deposit",
              "host": [
                "{{transaction_service_url}}"
              ],
              "path": [
                "api",
                "v1",
                "transactions",
                "deposit"
              ]
            }
